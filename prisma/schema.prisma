// BillBistro core schema — Phase 0.
// Rules: every tenant table has tenant_id + created_at/updated_at + deleted_at (soft delete).
// Money = integer minor units (paise). RLS policies live in prisma/migrations/*_rls.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // app role — subject to RLS
  directUrl = env("DATABASE_URL_MIGRATE") // owner role — used by migrate/introspect
}

enum OrderStatus {
  OPEN
  BILLED
  SETTLED
  CANCELLED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum KotStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum BillStatus {
  DRAFT
  FINAL
  VOID
}

enum PaymentMode {
  CASH
  UPI
  CARD
  WALLET
  OTHER
}

enum TableStatus {
  FREE
  OCCUPIED
  RESERVED
  BILLED
  CLEANING
  BLOCKED
}

enum PaymentStatus {
  PENDING
  CAPTURED
  FAILED
  REFUNDED
}

model Tenant {
  id        String    @id @default(uuid()) @db.Uuid
  /// self-reference so the RLS policy is uniform (tenant_id = id)
  tenantId  String    @map("tenant_id") @db.Uuid
  slug      String    @unique
  name      String
  country   String    @default("IN")
  currency  String    @default("INR")
  timezone  String    @default("Asia/Kolkata")
  gstin     String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  outlets Outlet[]
  users   User[]
  roles   Role[]

  @@map("tenants")
}

model Outlet {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  code      String
  name      String
  address   String?
  phone     String?
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  orders       Order[]
  bills        Bill[]
  userRoles    UserRole[]
  outletPrices ItemOutletPrice[]
  sections     FloorSection[]
  tables       RestaurantTable[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("outlets")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  email        String
  name         String
  phone        String?
  passwordHash String    @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  failedLogins Int       @default(0) @map("failed_logins")
  lockedUntil  DateTime? @map("locked_until")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  userRoles     UserRole[]
  refreshTokens RefreshToken[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model Role {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  key       String // owner | manager | cashier | kitchen
  name      String
  isSystem  Boolean   @default(false) @map("is_system")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  permissions RolePermission[]
  userRoles   UserRole[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("roles")
}

/// Platform-wide permission catalogue (NOT tenant-scoped; read-only reference data).
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique // e.g. menu.read, orders.write, bills.void
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id])
  permissionId String     @map("permission_id") @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id])
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  @@unique([roleId, permissionId])
  @@index([tenantId])
  @@map("role_permissions")
}

/// A user role assignment, optionally scoped to one outlet (null = all outlets of the tenant).
model UserRole {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id])
  roleId    String    @map("role_id") @db.Uuid
  role      Role      @relation(fields: [roleId], references: [id])
  outletId  String?   @map("outlet_id") @db.Uuid
  outlet    Outlet?   @relation(fields: [outletId], references: [id])
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([userId, roleId, outletId])
  @@index([tenantId])
  @@map("user_roles")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId, userId])
  @@map("refresh_tokens")
}

// ---------------- Menu ----------------
// Tenant-level catalogue; per-outlet price/availability overrides via ItemOutletPrice.
// Effective price = (ItemOutletPrice.price ?? MenuItem.basePrice) + MenuVariant.priceDelta + sum(ModifierOption.price)

/// Time window (e.g. Breakfast 07:00-11:00, Happy hour Mon-Fri 16:00-19:00). daysMask bit0=Sun..bit6=Sat.
model MenuSchedule {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String
  daysMask    Int       @default(127) @map("days_mask")
  startMinute Int       @map("start_minute") // minutes from midnight, outlet-local
  endMinute   Int       @map("end_minute")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  categories MenuCategory[]
  items      MenuItem[]

  @@index([tenantId])
  @@map("menu_schedules")
}

model MenuCategory {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  name        String
  description String?
  imageUrl    String?       @map("image_url")
  sortOrder   Int           @default(0) @map("sort_order")
  isActive    Boolean       @default(true) @map("is_active")
  scheduleId  String?       @map("schedule_id") @db.Uuid
  schedule    MenuSchedule? @relation(fields: [scheduleId], references: [id])
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")

  items MenuItem[]

  @@index([tenantId])
  @@map("menu_categories")
}

model MenuItem {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  categoryId  String        @map("category_id") @db.Uuid
  category    MenuCategory  @relation(fields: [categoryId], references: [id])
  sku         String?
  name        String
  description String?
  imageUrl    String?       @map("image_url")
  /// base price in minor units (paise)
  basePrice   Int           @map("base_price")
  /// GST rate in basis points (500 = 5%)
  taxRateBps  Int           @default(500) @map("tax_rate_bps")
  /// HSN/SAC code for GST invoices
  hsnCode     String?       @map("hsn_code")
  isVeg       Boolean       @default(true) @map("is_veg")
  isAvailable Boolean       @default(true) @map("is_available")
  sortOrder   Int           @default(0) @map("sort_order")
  /// kitchen station / KOT routing hint
  station     String?
  scheduleId  String?       @map("schedule_id") @db.Uuid
  schedule    MenuSchedule? @relation(fields: [scheduleId], references: [id])
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")

  variants       MenuVariant[]
  modifierGroups MenuItemModifierGroup[]
  outletPrices   ItemOutletPrice[]
  comboItems     ComboItem[]
  orderItems     OrderItem[]

  @@unique([tenantId, sku])
  @@index([tenantId, categoryId])
  @@map("menu_items")
}

/// Size/portion choice (Half / Full / Large). priceDelta added to the effective base price.
model MenuVariant {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  itemId      String    @map("item_id") @db.Uuid
  item        MenuItem  @relation(fields: [itemId], references: [id])
  name        String
  priceDelta  Int       @default(0) @map("price_delta")
  isDefault   Boolean   @default(false) @map("is_default")
  sortOrder   Int       @default(0) @map("sort_order")
  isAvailable Boolean   @default(true) @map("is_available")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  comboItems ComboItem[]

  @@index([tenantId, itemId])
  @@map("menu_variants")
}

/// Reusable add-on group (e.g. "Toppings" min 0 max 3, "Spice level" min 1 max 1).
model ModifierGroup {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String
  minSelect Int       @default(0) @map("min_select")
  maxSelect Int       @default(1) @map("max_select")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  options ModifierOption[]
  items   MenuItemModifierGroup[]

  @@index([tenantId])
  @@map("modifier_groups")
}

model ModifierOption {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  groupId     String        @map("group_id") @db.Uuid
  group       ModifierGroup @relation(fields: [groupId], references: [id])
  name        String
  price       Int           @default(0)
  isDefault   Boolean       @default(false) @map("is_default")
  isAvailable Boolean       @default(true) @map("is_available")
  sortOrder   Int           @default(0) @map("sort_order")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")

  @@index([tenantId, groupId])
  @@map("modifier_options")
}

/// Attach a modifier group to an item.
model MenuItemModifierGroup {
  id        String        @id @default(uuid()) @db.Uuid
  tenantId  String        @map("tenant_id") @db.Uuid
  itemId    String        @map("item_id") @db.Uuid
  item      MenuItem      @relation(fields: [itemId], references: [id])
  groupId   String        @map("group_id") @db.Uuid
  group     ModifierGroup @relation(fields: [groupId], references: [id])
  sortOrder Int           @default(0) @map("sort_order")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  deletedAt DateTime?     @map("deleted_at")

  @@unique([itemId, groupId])
  @@index([tenantId, itemId])
  @@map("menu_item_modifier_groups")
}

/// Per-outlet price / availability override. Absent row = use MenuItem.basePrice / isAvailable.
model ItemOutletPrice {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  itemId      String    @map("item_id") @db.Uuid
  item        MenuItem  @relation(fields: [itemId], references: [id])
  outletId    String    @map("outlet_id") @db.Uuid
  outlet      Outlet    @relation(fields: [outletId], references: [id])
  price       Int?
  isAvailable Boolean?  @map("is_available")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@unique([itemId, outletId])
  @@index([tenantId, outletId])
  @@map("item_outlet_prices")
}

/// Fixed-price bundle of items (e.g. Thali, Meal deal). Tax computed per component line at order time.
model Combo {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String
  description String?
  imageUrl    String?   @map("image_url")
  price       Int
  isAvailable Boolean   @default(true) @map("is_available")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  items ComboItem[]

  @@index([tenantId])
  @@map("combos")
}

model ComboItem {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  comboId   String       @map("combo_id") @db.Uuid
  combo     Combo        @relation(fields: [comboId], references: [id])
  itemId    String       @map("item_id") @db.Uuid
  item      MenuItem     @relation(fields: [itemId], references: [id])
  variantId String?      @map("variant_id") @db.Uuid
  variant   MenuVariant? @relation(fields: [variantId], references: [id])
  qty       Int          @default(1)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  deletedAt DateTime?    @map("deleted_at")

  @@index([tenantId, comboId])
  @@map("combo_items")
}

// ---------------- Floor: sections & tables ----------------
model FloorSection {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  outletId  String    @map("outlet_id") @db.Uuid
  outlet    Outlet    @relation(fields: [outletId], references: [id])
  name      String // Ground floor / Terrace / AC hall
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tables RestaurantTable[]

  @@unique([outletId, name])
  @@index([tenantId, outletId])
  @@map("floor_sections")
}

/// A physical table. status is live occupancy; currentOrderId is set by the ordering module (T-102).
model RestaurantTable {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  outletId       String       @map("outlet_id") @db.Uuid
  outlet         Outlet       @relation(fields: [outletId], references: [id])
  sectionId      String       @map("section_id") @db.Uuid
  section        FloorSection @relation(fields: [sectionId], references: [id])
  code           String // T1, T2, VIP-1
  capacity       Int          @default(4)
  status         TableStatus  @default(FREE)
  statusSince    DateTime     @default(now()) @map("status_since")
  currentOrderId String?      @map("current_order_id") @db.Uuid
  /// floor-map coordinates (0-1000 grid) for the POS layout editor
  posX           Int          @default(0) @map("pos_x")
  posY           Int          @default(0) @map("pos_y")
  sortOrder      Int          @default(0) @map("sort_order")
  isActive       Boolean      @default(true) @map("is_active")
  version        Int          @default(1)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  orders Order[]

  @@unique([outletId, code])
  @@index([tenantId, outletId, status])
  @@map("tables")
}

// ---------------- Orders / KOT / Bills / Payments ----------------
model Order {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  outletId    String      @map("outlet_id") @db.Uuid
  outlet      Outlet      @relation(fields: [outletId], references: [id])
  orderNo     String      @map("order_no")
  type        OrderType   @default(DINE_IN)
  status      OrderStatus @default(OPEN)
  tableRef    String?     @map("table_ref")
  tableId     String?     @map("table_id") @db.Uuid
  table       RestaurantTable? @relation(fields: [tableId], references: [id])
  guestCount  Int?        @map("guest_count")
  notes       String?
  cancelledAt DateTime?   @map("cancelled_at")
  cancelReason String?    @map("cancel_reason")
  subtotal    Int         @default(0)
  taxTotal    Int         @default(0) @map("tax_total")
  discount    Int         @default(0)
  total       Int         @default(0)
  /// idempotency key supplied by the POS client
  clientKey   String?     @map("client_key")
  version     Int         @default(1)
  createdById String?     @map("created_by_id") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  deletedAt   DateTime?   @map("deleted_at")

  items OrderItem[]
  kots  Kot[]
  bills Bill[]

  @@unique([tenantId, outletId, orderNo])
  @@unique([tenantId, clientKey])
  @@index([tenantId, outletId, status])
  @@map("orders")
}

model OrderItem {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  orderId     String    @map("order_id") @db.Uuid
  order       Order     @relation(fields: [orderId], references: [id])
  itemId      String    @map("item_id") @db.Uuid
  item        MenuItem  @relation(fields: [itemId], references: [id])
  name        String // snapshot at time of order
  variantName String?   @map("variant_name")
  variantId   String?   @map("variant_id") @db.Uuid
  clientLineId String?  @map("client_line_id")
  /// unit price before tax = base/outlet price + variant delta + modifiers (snapshot)
  qty         Int
  unitPrice   Int       @map("unit_price")
  taxRateBps  Int       @map("tax_rate_bps")
  lineTotal   Int       @map("line_total")
  notes       String?
  kotId       String?   @map("kot_id") @db.Uuid
  kot         Kot?      @relation(fields: [kotId], references: [id])
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  modifiers OrderItemModifier[]

  @@index([tenantId, orderId])
  @@map("order_items")
}

/// Snapshot of a chosen modifier option on an order line (price frozen at order time).
model OrderItemModifier {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  orderItemId String    @map("order_item_id") @db.Uuid
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  optionId    String?   @map("option_id") @db.Uuid
  name        String
  price       Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@index([tenantId, orderItemId])
  @@map("order_item_modifiers")
}

/// Per-outlet document counters (order_no, kot_no, bill_no). Incremented under row lock.
model Sequence {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  outletId  String   @map("outlet_id") @db.Uuid
  key       String // order | kot | bill
  value     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([outletId, key])
  @@index([tenantId])
  @@map("sequences")
}

model Kot {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  orderId   String    @map("order_id") @db.Uuid
  order     Order     @relation(fields: [orderId], references: [id])
  kotNo     String    @map("kot_no")
  status    KotStatus @default(PENDING)
  station   String? // kitchen station / printer
  outletId  String    @map("outlet_id") @db.Uuid
  readyAt   DateTime? @map("ready_at")
  servedAt  DateTime? @map("served_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  items OrderItem[]

  @@index([tenantId, orderId])
  @@map("kots")
}

model Bill {
  id          String     @id @default(uuid()) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  outletId    String     @map("outlet_id") @db.Uuid
  outlet      Outlet     @relation(fields: [outletId], references: [id])
  orderId     String     @map("order_id") @db.Uuid
  order       Order      @relation(fields: [orderId], references: [id])
  billNo      String     @map("bill_no")
  status      BillStatus @default(DRAFT)
  subtotal    Int
  taxTotal    Int        @map("tax_total")
  discount    Int        @default(0)
  roundOff    Int        @default(0) @map("round_off")
  total       Int
  version     Int        @default(1)
  finalizedAt DateTime?  @map("finalized_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deletedAt   DateTime?  @map("deleted_at")

  payments Payment[]

  @@unique([tenantId, outletId, billNo])
  @@index([tenantId, orderId])
  @@map("bills")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  billId         String        @map("bill_id") @db.Uuid
  bill           Bill          @relation(fields: [billId], references: [id])
  mode           PaymentMode
  status         PaymentStatus @default(PENDING)
  amount         Int
  reference      String? // UPI txn id / card slip
  idempotencyKey String?       @map("idempotency_key")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, billId])
  @@map("payments")
}

// ---------------- Audit (append-only; no UPDATE/DELETE grant, see rls migration) ----------------
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String // auth.login | bill.void | menu.item.price_override ...
  entity      String
  entityId    String?  @map("entity_id") @db.Uuid
  before      Json?
  after       Json?
  ip          String?
  requestId   String?  @map("request_id")
  meta        Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId, entity, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}
