{
  "name": "billbistro",
  "private": true,
  "packageManager": "npm@10.9.3",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:rls-check": "tsx scripts/rls-check.ts",
    "api:dev": "npm run dev --workspace=@billbistro/api",
    "db:iso-check": "tsx scripts/tenant-isolation.check.ts",
    "db:hardening-check": "tsx scripts/hardening-check.ts",
    "check:money": "tsx scripts/money-check.ts",
    "db:orders-e2e": "tsx scripts/orders-e2e.ts",
    "db:billing-e2e": "tsx scripts/billing-e2e.ts",
    "db:reports-e2e": "tsx scripts/reports-e2e.ts",
    "db:signup-e2e": "tsx scripts/signup-e2e.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prisma": "^6.4.0",
    "tsx": "^4.19.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@prisma/client": "^6.4.0",
    "argon2": "^0.41.1",
    "dotenv": "^16.4.7"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "@types/express": "^4.17.21",
    "deepmerge-ts": "^8.0.2",
    "qs": "^6.16.0"
  }
}
