{
  "name": "billbistro",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:rls-check": "tsx scripts/rls-check.ts",
    "api:dev": "pnpm --filter @billbistro/api dev"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prisma": "^6.4.0",
    "tsx": "^4.19.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@prisma/client": "^6.4.0",
    "argon2": "^0.41.1",
    "dotenv": "^16.4.7"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  }
}
