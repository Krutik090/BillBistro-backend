# Postgres — app role (subject to RLS) and migration role (table owner / superuser)
DATABASE_URL=postgresql://billbistro_app:app@localhost:5432/billbistro?schema=public
DATABASE_URL_MIGRATE=postgresql://postgres:postgres@localhost:5432/billbistro?schema=public
REDIS_URL=redis://localhost:6379
# Auth
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
COOKIE_SECURE=false
API_PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
