# Postgres — app role (subject to RLS) and migration role (table owner / superuser)
DATABASE_URL=postgresql://billbistro_app:app@localhost:5433/billbistro?schema=public
DATABASE_URL_MIGRATE=postgresql://postgres:postgres@localhost:5433/billbistro?schema=public
REDIS_URL=redis://localhost:6379
# Auth
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
COOKIE_SECURE=false
API_PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
# Hardening
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
# Single-restaurant deployment: which tenant serves PUBLIC routes (QR menu/ordering, no staff
# session). Should match SEED_TENANT_SLUG below.
PUBLIC_TENANT_SLUG=demo
# Seed (npm run db:seed) — edit these to your actual restaurant, then re-seed.
SEED_TENANT_SLUG=demo
SEED_TENANT_NAME=Demo Restaurant
SEED_OWNER_EMAIL=owner@demo.local
SEED_OWNER_PASSWORD=Password123!
SEED_OWNER_NAME=Demo Owner
SEED_OUTLET_NAME=Main Outlet
SEED_OUTLET_ADDRESS=Ahmedabad, GJ
# Set to false once you're ready to build your own menu/floor from the dashboard instead of the sample data.
SEED_SAMPLE_DATA=true
